# Neon pooled connection string used by the Next.js application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Neon direct (non-pooler) connection, used only by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

# Better Auth. Generate a secret with: npx auth@latest secret
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
# Optional Better Auth Infrastructure dashboard integration.
BETTER_AUTH_API_KEY=""
# Set to false only while creating the first trusted account.
BETTER_AUTH_DISABLE_SIGN_UP="true"

# Set true only for local UI work without Better Auth/Neon credentials.
ALLOW_INSECURE_LOCAL_DEV="false"
